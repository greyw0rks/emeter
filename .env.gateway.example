# Copy this template to an external file, for example:
# ~/.local/share/emeter/credentials/gateway.env
# Start processes with EMETER_RUNTIME_ENV pointing to that external file.
DATABASE_URL=postgresql://emeter@127.0.0.1:55432/emeter
REDIS_URL=redis://127.0.0.1:56379/0
EMETER_PROVIDER_DISPATCH_SECRET=
X_LAYER_RPC_URL=https://rpc.xlayer.tech
EMETER_NETWORK_MODE=mainnet
GATEWAY_ORIGIN=http://127.0.0.1:4100
EMETER_PROVIDER_ORIGIN=http://127.0.0.1:4110
EMETER_PROVIDER_ORIGINS=http://127.0.0.1:4110
EMETER_CONFIRMATIONS=3
EMETER_EXECUTION_TIMEOUT_MS=28000
EMETER_RELAYER_GAS_BUDGET_WEI=1000000000000000

# Signing and AI credentials remain outside the repository.
# The signer file must contain the keys for the configured public addresses.
EMETER_SIGNER_FILE=
EMETER_DEPLOYER_ADDRESS=
EMETER_PROVIDER_SIGNER_ADDRESS=
EMETER_AI_PROVIDER=otari
EMETER_AI_MODEL=mistralai/mistral-small-3.2-24b
EMETER_OTARI_ENV_FILE=
