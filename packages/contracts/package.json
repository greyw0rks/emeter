{
  "name": "@emeter/contracts",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install:libs": "forge install foundry-rs/forge-std@v1.17.0 --no-git",
    "build": "forge build",
    "test": "forge test --no-match-path 'test/*Fork.t.sol'",
    "test:fork": "forge test --match-path test/XLayerFork.t.sol -vvv",
    "test:engine:fork": "forge test --match-path test/EngineFork.t.sol -vvv",
    "format": "forge fmt --check"
  },
  "dependencies": { "@openzeppelin/contracts": "5.6.1" }
}
