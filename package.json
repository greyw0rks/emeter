{
  "name": "emeter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "test": "pnpm -r --if-present test",
    "circuit:generate": "pnpm --filter @emeter/circuit generate",
    "contracts:install": "pnpm --filter @emeter/contracts install:libs",
    "contracts:build": "pnpm --filter @emeter/contracts build",
    "contracts:bindings": "tsx scripts/deploy/export-engine-abi.ts",
    "db:generate": "pnpm --filter @emeter/database generate",
    "test:engine:fork": "pnpm --filter @emeter/contracts test:engine:fork",
    "test:fork": "pnpm --filter @emeter/contracts test:fork",
    "verify:xlayer": "tsx scripts/verify/xlayer.ts",
    "verify:deployment": "tsx scripts/verify/deployment.ts",
    "verify:engine": "tsx scripts/verify/engine-deployment.ts",
    "proof:local": "tsx scripts/verify/local-proof.ts",
    "proof:engine:local": "tsx scripts/verify/engine-local.ts",
    "proof:gateway": "tsx scripts/verify/gateway.ts",
    "deploy:engine": "tsx scripts/deploy/engine-mainnet.ts",
    "deploy:prepare": "tsx scripts/deploy/prepare.ts",
    "deploy:mainnet": "tsx scripts/deploy/mainnet.ts",
    "dev:web": "pnpm --filter @emeter/web dev",
    "dev:gateway": "pnpm --filter @emeter/gateway dev"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@emeter/circuit": "workspace:*",
    "@emeter/shared": "workspace:*",
    "@emeter/sdk": "workspace:*",
    "viem": "2.58.1",
    "zod": "4.6.7"
  }
}
