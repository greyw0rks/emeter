# Public configuration. Never commit a populated .env file.
X_LAYER_RPC_URL=https://rpc.xlayer.tech
X_LAYER_SECONDARY_RPC_URL=https://xlayer.drpc.org
TAPEOUT_FACTORY_ADDRESS=0x1f09DAeFA827f02CBb40967cc91b259763760761
TAPEOUT_BEACON_ADDRESS=0xf70d1ed4f62CF3780157B0b421b7E2F45bD0991C
# Fill these from verified deployment receipts; do not invent addresses or IDs.
TAPEOUT_PROCESSOR_ADDRESS=
TAPEOUT_CIRCUIT_ID=
EMETER_DEMO_TOKEN_ADDRESS=
EMETER_POLICY_ADAPTER_ADDRESS=
EMETER_PROOF_VAULT_ADDRESS=
EMETER_REGISTRY_ADDRESS=
EMETER_VAULT_ADDRESS=

# Optional PUBLIC deployment address and encrypted Foundry account name.
# Mainnet signing is performed by the wallet/keystore, never a checked-in key.
EMETER_DEPLOYER_ADDRESS=
EMETER_FOUNDRY_ACCOUNT=
# Keep any private key in the process environment only, outside this repository.
# EMETER_DEPLOYER_PRIVATE_KEY is intentionally omitted from this example.
EMETER_MAX_NATIVE_SPEND_WEI=10000000000000000
EMETER_SIGNER_FILE=
EMETER_PROVIDER_SIGNER_ADDRESS=

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4100
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:4100
